{% extends "layouts/default.njk" %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "includes/csrf.njk" import csrfProtection %}

{% set currentApp = "Electoral register management" %}

{% block page_title %}{{ serviceName }} - Electoral register management - Initial ER email{% endblock %}
{% block page_identifier %}Electoral register management - Initial ER email{% endblock %}

{% block content %}

  {% include "includes/errors.njk" %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if indivdualLaFlow %}
        <span class="govuk-caption-xl">{{ localAuthorityInfo.localAuthorityName }}</span>
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">Are you sure you want to send the initial ER email?</h1>
      {% else %}
        <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">Are you sure you want to send the initial ER email to {{ noLocalAuthorities }} local {{ "authorities" if noLocalAuthorities > 1 else "authority" }}?</h1>
      {% endif %}

      <p class="govuk-body">This email asks the selected local authorities to upload their electoral register data by the deadline.</p>

      <form action="{{ postUrl }}" method="post" id="initialErEmailForm">
        <div class="govuk-button-group">
          {{ govukButton({
            text: "Yes - send initial ER email" + ("s" if not indivdualLaFlow else ""),
            type: "submit"
          }) }}

          <a class="govuk-link govuk-link--no-visited-state" href="{{ cancelUrl }}">No - cancel</a>
        </div>

        {{ csrfProtection(csrftoken) }}
      </form>

    </div>
  </div>

{% endblock %}
