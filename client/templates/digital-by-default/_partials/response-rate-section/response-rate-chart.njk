<div class="dashboard-section">
  <div class="moj-page-header-actions">
    <div class="moj-page-header-actions__title">
      <h2 class="govuk-heading-l">Response rate</h2>
    </div>
    <div class="moj-page-header-actions__actions">
      <button type="button" class="govuk-button govuk-button--secondary" onclick="downloadCSV('table-response-rate', 'response-rate.csv')">
        Download CSV
      </button>
    </div>
  </div>

{#
  <div class="chart-container">
    <canvas id="totalResponsesChart" width="687" height="255"></canvas>
  </div>

  <div class="chart-container">
    <canvas id="responseRateChart" width="687" height="255"></canvas>
  </div>
#}

  {{ govukTable({
    attributes: {
      id: "table-response-rate"
    },
    caption: "Response rate by court or group",
    captionClasses: "govuk-visually-hidden",
    head: responseRateHeadList,
    rows: responseRateRowList,
    firstCellIsHeader: true,
    classes: "govuk-body-s"
  }) }}
</div>
