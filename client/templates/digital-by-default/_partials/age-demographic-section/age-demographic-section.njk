{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "./age-demographics-by-court-chart.njk" import ageDemographicsByCourtChart %}

<div class="dashboard-section">

    <div class="moj-page-header-actions">
        <div class="moj-page-header-actions__title">
            <h2 class="govuk-heading-l">Age demographics</h2>
        </div>
        <div class="moj-page-header-actions__actions">
            <button type="button" id="download-age-demographic-csv" class="govuk-button govuk-button--secondary" data-download-url="{{ ageDemographicCsvRoute }}">
                Download CSV
            </button>
        </div>
    </div>

    {# Age demographics by court chart #}
    {{ ageDemographicsByCourtChart({
        data: ageDemographicsChartData,
        compare: dashboardFormData.dateRangeCompare,
        dateRangeLabelA: displayDateRange.dateRangeLabelA,
        dateRangeLabelB: displayDateRange.dateRangeLabelB,
        nonce: nonce
    }) }}

    {% if ageDemographicTableData.rows | length %}
        {{ govukTable({
        id: "ageDemographicTable",
        caption: "Age demographics",
        captionClasses: "govuk-visually-hidden",
        head: ageDemographicTableData.head,
        rows: ageDemographicTableData.rows
        }) }}

    {% else %}
        <hr class="govuk-section-break govuk-section-break--visible govuk-!-margin-top-3">
        <h2>Age demographics - no data found</h2>
    {% endif %}

</div>

<script nonce="{{ nonce }}">
    document.getElementById('download-age-demographic-csv').addEventListener('click', function() {
        window.location.href = this.dataset.downloadUrl;
    });
</script>
