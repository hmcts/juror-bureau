{% macro totalResponsesChart(params) %}
  <div class="chart-container">
    <canvas
      id="totalResponsesChart"
      name="totalResponsesChart"
      width="687"
      height="255"
      aria-label="Total responses by court or group"
      role="img">
    </canvas>
  </div>

  <script nonce="{{ params.nonce }}">
    (function() {
      var canvas = document.getElementById('totalResponsesChart');

      if (!canvas || typeof Chart === 'undefined') {
        return;
      }

      var labels = ("{{ params.labels }}").split(',');
      var digitalValues = ("{{ params.valuesDigital }}").split(',');
      var paperValues = ("{{ params.valuesPaper }}").split(',');

      Chart.defaults.global.defaultFontSize = 20;
      Chart.defaults.scale.gridLines.drawOnChartArea = false;

      new Chart(canvas.getContext('2d'), {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Digital',
              stack: 'total-responses',
              data: digitalValues,
              backgroundColor: '#5694ca'
            },
            {
              label: 'Paper',
              stack: 'total-responses',
              data: paperValues,
              backgroundColor: '#f499be'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          tooltips: {
            mode: 'index',
            intersect: false
          },
          scales: {
            xAxes: [{
              stacked: true
            }],
            yAxes: [{
              stacked: true,
              ticks: {
                beginAtZero: true
              }
            }]
          }
        },
        plugins: [{
          beforeInit: function(chart) {
            chart.data.labels.forEach(function(label, index, allLabels) {
              if (/\n/.test(label)) {
                allLabels[index] = label.split(/\n/);
              }
            });
          }
        }]
      });
    })();
  </script>
{% endmacro %}
